# --- Gemini API ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wellsynthai_documents

# --- Pipeline ---
MAX_CONCURRENT_BATCHES=25
BATCH_SIZE=5
MEDIA_RESOLUTION_DEFAULT=MEDIUM

# --- Storage ---
OUTPUT_DIR=./data/output

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
