# --- Gemini API ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wellsynthai_documents

# --- Pipeline ---
MAX_CONCURRENT_BATCHES=25
BATCH_SIZE=5
MEDIA_RESOLUTION_DEFAULT=MEDIUM

# --- Storage (legacy filesystem; will be removed after PR-6 storage migration) ---

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Supabase (PR-5 onwards) — Project Settings → API & Database in the dashboard
# ---------------------------------------------------------------------------

# Public REST URL of the Supabase project (e.g. https://<ref>.supabase.co).
# Same value the frontend uses as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose to the browser. Frontend reads this as
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Backend uses it only for non-privileged calls.
SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — full DB / Storage access. SERVER-ONLY. Never ship to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWKS endpoint for verifying Supabase Auth JWTs.
# Supabase signs access tokens with ES256 (asymmetric); the backend fetches
# the public key set from this URL and caches it. There is no shared secret.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Postgres connection used by the FastAPI app (SQLAlchemy + asyncpg).
# Use the Session Pooler on port 5432 (works on IPv4; full Postgres features).
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Postgres connection used by the Celery worker.
# Also Session Pooler at our scale (≤ ~50 internal users). Switch to the
# Transaction Pooler (port 6543) only if connection-cap pressure shows up,
# and remember to set statement_cache_size=0 in asyncpg connect args.
WORKER_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Storage bucket names (created via Supabase CLI in PR-6).
SUPABASE_BUCKET_PDFS=pdfs
SUPABASE_BUCKET_PAGES=pages
SUPABASE_BUCKET_ARTIFACTS=artifacts
